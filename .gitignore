!/index.html
!/manifest.webmanifest
!/favicon.ico
!/icon-192.png
!/icon-512.png
!/apple-touch-icon.png
!/css/
/css/*
!/css/style.css
!/css/tokens.css
!/js/
/js/*
!/js/data.js
!/js/cars.js
!/js/towns.js
!/js/frontier.js
!/js/cargo.js
!/js/art.js
!/js/game.js
!/js/hexmap.js
!/js/sound.js
!/js/tutorial.js
!/js/ui.js
!/img/
/img/*
!/img/trains/
!/img/cars/
/img/trains/*
/img/cars/*
!/img/trains/*.png
!/img/cars/*.png
!/img/trains/s/
/img/trains/s/*
!/img/trains/s/*.webp
!/img/trains/m/
/img/trains/m/*
!/img/trains/m/*.webp
!/img/cars/s/
/img/cars/s/*
!/img/cars/s/*.webp
!/img/cars/m/
/img/cars/m/*
!/img/cars/m/*.webp
